# Copy to deploy/.env (ignored by Git); fill locally, never commit values.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
ADMIN_INITIAL_PASSWORD=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
# false for local HTTP; set true only when accessed through trusted HTTPS.
SESSION_COOKIE_SECURE=false

# Optional shared sessions. Enable explicitly; use compose.redis.yaml for an owned Redis service.
LIANZHI_REDIS_ENABLED=false
LIANZHI_REDIS_HOST=127.0.0.1
LIANZHI_REDIS_PORT=6379
LIANZHI_REDIS_DATABASE=0
LIANZHI_REDIS_USERNAME=
LIANZHI_REDIS_PASSWORD=
LIANZHI_REDIS_TLS=false
LIANZHI_REDIS_NAMESPACE=lianzhi:session:v1
LIANZHI_REDIS_CONNECT_TIMEOUT=1s
LIANZHI_REDIS_COMMAND_TIMEOUT=1s
LIANZHI_SESSION_TIMEOUT=30m

# Optional real services; Ollama URLs are root URLs, not /api/chat or /api/embed.
# For a host service from Docker, use a host address reachable from the container.
LIANZHI_AI_BASE_URL=
LIANZHI_AI_MODEL=
LIANZHI_AI_TIMEOUT_SECONDS=45
LIANZHI_EMBEDDING_BASE_URL=
LIANZHI_EMBEDDING_MODEL=
LIANZHI_EMBEDDING_REVISION=1
# OCR/transcription are full endpoints implementing docs/modules/c-media-services.md.
LIANZHI_OCR_URL=
LIANZHI_OCR_TOKEN=
LIANZHI_TRANSCRIPTION_URL=
LIANZHI_TRANSCRIPTION_TOKEN=
# Browser map credentials; restricted to your authorized web origins in the provider console.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

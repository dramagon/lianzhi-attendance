# Copy to an ignored local file such as artifacts/c-mysql-ai.env.
# Literal values only; no PowerShell/shell expansion is performed.
DB_URL=jdbc:mysql://127.0.0.1:3306/lianzhi?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=lianzhi
DB_PASSWORD=
# Used only to initialize an empty non-demo user database. Does not reset existing accounts.
ADMIN_INITIAL_PASSWORD=

# Paths default to this project's artifacts. Configure when installed elsewhere.
# JAVA_HOME=C:/Program Files/Java/jdk-17
# LIANZHI_RUNTIME_DIRECTORY=D:/lianzhi-runtime
# LIANZHI_DATA_DIRECTORY=D:/lianzhi-data
# LIANZHI_OLLAMA_EXECUTABLE=D:/lianzhi-runtime/ollama-cpu/ollama.exe
# LIANZHI_MEDIA_PYTHON=D:/lianzhi-runtime/c-media-venv/Scripts/python.exe
# LIANZHI_FFMPEG_DIRECTORY=D:/lianzhi-runtime/ffmpeg/bin
# LIANZHI_WHISPER_MODEL=D:/lianzhi-runtime/local-ai/whisper-tiny
# OLLAMA_MODELS=D:/lianzhi-runtime/local-ai/ollama-models
LIANZHI_AI_MODEL=qwen2.5:1.5b
LIANZHI_AI_TIMEOUT_SECONDS=60
LIANZHI_EMBEDDING_MODEL=qwen3-embedding:0.6b
LIANZHI_EMBEDDING_REVISION=1

# Optional shared sessions; all instances must use the same Redis database and versioned namespace.
LIANZHI_REDIS_ENABLED=false
LIANZHI_REDIS_HOST=127.0.0.1
LIANZHI_REDIS_PORT=6379
LIANZHI_REDIS_DATABASE=0
LIANZHI_REDIS_USERNAME=
LIANZHI_REDIS_PASSWORD=
LIANZHI_REDIS_TLS=false
LIANZHI_REDIS_NAMESPACE=lianzhi:session:v1
LIANZHI_REDIS_CONNECT_TIMEOUT=1s
LIANZHI_REDIS_COMMAND_TIMEOUT=1s
LIANZHI_SESSION_TIMEOUT=30m
# Face configuration and A's local credential loading remain optional and unchanged.

# Documentation sample only; Spring reads these as environment variables, not from this file.
# V4/V4.1/V5 storage is published. Keep processing disabled until an authorized Windows x64 SDK adapter exists.
LIANZHI_FACE_ENABLED=false
LIANZHI_FACE_REQUIRED=false
# Base64 of exactly 32 random bytes. Keep stable across restarts; never commit the actual value.
LIANZHI_FACE_ENCRYPTION_KEY=
# Normalized score in (0,1), calibrated using the actual licensed SDK. No guessed default.
LIANZHI_FACE_MINIMUM_SCORE=-1

# Documentation sample only; Spring reads these as environment variables, not from this file.
# V4/V4.1/V5 storage is published. ArcFace 3.0 Windows x64 is optional and requires local licensing.
LIANZHI_FACE_ENABLED=false
LIANZHI_FACE_REQUIRED=false
# Base64 of exactly 32 random bytes. Keep stable across restarts; never commit the actual value.
LIANZHI_FACE_ENCRYPTION_KEY=
# Normalized score in (0,1), calibrated using the actual licensed SDK. No guessed default.
LIANZHI_FACE_MINIMUM_SCORE=-1
# Optional SDK adapter. Do not commit actual values or vendor binaries.
LIANZHI_ARCSOFT_ENABLED=false
LIANZHI_ARCSOFT_JAR=
LIANZHI_ARCSOFT_NATIVE_DIRECTORY=
LIANZHI_ARCSOFT_APP_ID=
LIANZHI_ARCSOFT_SDK_KEY=
# RGB only; this does not enable IR liveness. This is an explicit SDK operating setting,
# not a measured false-acceptance guarantee. Validate it with the intended camera.
LIANZHI_ARCSOFT_RGB_LIVENESS_THRESHOLD=0.8
